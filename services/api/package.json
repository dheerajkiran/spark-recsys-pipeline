    "start": "node dist/main.js",
    "local:admin": "tsx src/local-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1167.0",
    "@aws-sdk/lib-dynamodb": "3.1167.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jose": "6.2.17"
  }
}
